# Production environment template for deploying to Railway.
#
# This is NOT loaded automatically — copy these into Railway's dashboard
# under your service's "Variables" tab (do not commit a real .env.production
# with actual secrets; this file only documents which variables to set and
# what values make sense for production).

APP_NAME="Document Editor"
APP_ENV=production
# Generate a fresh key locally with `php artisan key:generate --show` and
# paste the result here. Do NOT reuse your local .env's APP_KEY.
APP_KEY=
APP_DEBUG=false
# Set this to the domain Railway gives you after the first deploy
# (Settings -> Networking -> Generate Domain), e.g. https://docedit-production.up.railway.app
APP_URL=https://REPLACE_WITH_YOUR_RAILWAY_DOMAIN

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Railway captures stdout/stderr as logs automatically — write there instead
# of storage/logs/laravel.log, which lives on the ephemeral container disk
# and won't be reachable/persisted anyway.
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Postgres, provisioned via Railway's "Postgres" plugin in the same project.
# Once added, Railway lets you reference its connection string as a variable:
# set DB_URL to the reference expression shown in your service's Variables
# tab, e.g. ${{Postgres.DATABASE_URL}} (Railway substitutes the real value
# at deploy time — you don't paste a literal connection string here).
DB_CONNECTION=pgsql
DB_URL="${{Postgres.DATABASE_URL}}"

# Both backed by Postgres rather than local disk/files, so nothing here
# depends on the container's ephemeral filesystem.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Swap for a real transactional mail provider before relying on password
# reset / email verification in production. `log` just writes mail to the
# (ephemeral) log stream, which is fine for a take-home demo but means
# outgoing email doesn't actually get delivered anywhere.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Explicitly off — this app doesn't build or run an SSR bundle in
# production (only `npm run build`, not `npm run build:ssr`), so leaving
# this on would be a no-op at best; setting it to false makes that explicit
# instead of relying on Inertia's silent "no SSR bundle found" fallback.
INERTIA_SSR_ENABLED=false
